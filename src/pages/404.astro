---
import Base from '../layouts/Base.astro';
import { url } from '../config';
import { getIssues } from '../lib/issues';

const [latest] = await getIssues();
---

<Base title="Page not found">
  <header class="page-head">
    <h1>There's no page at this address.</h1>
    <p>
      It may have moved. Start from the <a href={url('/')}>home page</a> or browse <a href={url('/issues')}
        >all issues</a
      >.
    </p>
    {
      latest && (
        <div class="actions recover">
          <a class="button primary" href={url(`/issues/${latest.id}`)}>Read issue {latest.data.issue}</a>
        </div>
      )
    }
  </header>
</Base>

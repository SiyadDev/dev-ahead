---
import { RUNGS, RUNG_MEANING, url } from '../config';
import { watch, isNew, formatDate, latestChanges } from '../lib/watch';

const { added, moved, held } = latestChanges();
const names = (list: { name: string }[]) => list.map((e) => e.name).join(', ');
const changes = [
  added.length > 0 && `${added.length} new (${names(added)})`,
  moved.length > 0 ? `${moved.length} moved rung (${names(moved)})` : 'no rung changes',
  held.length > 0 && `${held.length} held with new evidence`,
].filter(Boolean);
---

<section class="ladder-wrap" aria-labelledby="ladder-title">
  <div class="ladder-head">
    <h2 id="ladder-title">Disruption Watch</h2>
    <p>Where each shift stands, updated <time datetime={watch.updated}>{formatDate(watch.updated)}</time></p>
  </div>
  <div class="ladder">
    {
      RUNGS.map((rung, i) => {
        const entries = watch.entries.filter((e) => e.status === rung);
        // Phones stack the steps highest first while the markup runs lowest
        // first, so each heading says where it sits for anyone hearing it.
        return (
          <div class="step">
            <h3>
              <span class="pips" aria-hidden="true">
                {RUNGS.map((_, j) => (
                  <i class={j <= i ? 'on' : ''} />
                ))}
              </span>
              {rung}
              <span class="visually-hidden">, rung {i + 1} of {RUNGS.length}, </span>
              <span class="count">
                {entries.length}
                <span class="visually-hidden"> {entries.length === 1 ? 'shift' : 'shifts'}</span>
              </span>
            </h3>
            <p class="step-meaning">{RUNG_MEANING[rung]}</p>
            {entries.length === 0 && <p class="step-empty">Nothing on this rung right now.</p>}
            <ul class="quiet-links">
              {entries.map((e) => (
                <li>
                  <a href={url(`/watch#${e.id}`)}>{e.name}</a>
                  {isNew(e) && (
                    <span class="new">
                      <span class="visually-hidden">, </span>New
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>
  <div class="ladder-foot">
    <p>
      <strong>This update:</strong>{' '}{changes.join(', ')}. A shift moves only on specific evidence.
    </p>
    <a href={url('/watch')}>See the evidence for each one</a>
  </div>
</section>

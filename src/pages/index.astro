---
import Base from '../layouts/Base.astro';
import Ladder from '../components/Ladder.astro';
import { SITE, url } from '../config';
import { getIssues } from '../lib/issues';
import { formatDate } from '../lib/watch';

const issues = await getIssues();
const [latest, ...older] = issues;
---

<Base>
  <section class="intro">
    <h1>What's moving underneath developer news.</h1>
    <p>
      A twice-weekly brief on the tools, AI capabilities and shifts in the economics of software that reach
      developers before they become headlines. By <a href={SITE.authorUrl}>{SITE.author}</a>.
    </p>
    <div class="actions">
      {
        SITE.linkedinNewsletter && (
          <a class="button primary" href={SITE.linkedinNewsletter}>
            Subscribe on LinkedIn
          </a>
        )
      }
      {latest && <a class={SITE.linkedinNewsletter ? 'button' : 'button primary'} href={url(`/issues/${latest.id}`)}>Read the latest issue</a>}
      <a class="button" href={url('/rss.xml')}>RSS feed</a>
    </div>
  </section>

  <Ladder />

  {
    latest && (
      <section class="section" aria-labelledby="latest-title">
        <h2 id="latest-title">Latest issue</h2>
        <article class="latest">
          <p class="meta">
            Issue {latest.data.issue}, {formatDate(latest.data.date)}
          </p>
          <h3>
            <a href={url(`/issues/${latest.id}`)}>{latest.data.title}</a>
          </h3>
          <p>{latest.data.summary}</p>
          <a class="sans" href={url(`/issues/${latest.id}`)}>Read issue {latest.data.issue}</a>
        </article>
      </section>
    )
  }

  {
    older.length > 0 && (
      <section class="section" aria-labelledby="archive-title">
        <h2 id="archive-title">Earlier issues</h2>
        <ul class="archive">
          {older.map((i) => (
            <li>
              <time datetime={i.data.date.toISOString()}>{formatDate(i.data.date)}</time>
              <a href={url(`/issues/${i.id}`)}>
                {i.data.issue}. {i.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

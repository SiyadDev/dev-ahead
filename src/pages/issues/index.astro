---
import Base from '../../layouts/Base.astro';
import { url } from '../../config';
import { getIssues, titleHtml } from '../../lib/issues';
import { formatDate } from '../../lib/watch';

const issues = await getIssues();
---

<Base title="All issues" description="Every issue of Ahead of Main, newest first.">
  <header class="page-head">
    <h1>All issues</h1>
    <p>Published twice a week. Newest first.</p>
  </header>
  <ul class="archive">
    {
      issues.map((i) => (
        <li>
          <time datetime={i.data.date.toISOString()}>{formatDate(i.data.date)}</time>
          <div>
            <a href={url(`/issues/${i.id}`)} set:html={`${i.data.issue}. ${titleHtml(i.data.title)}`} />
            <p class="archive-summary">{i.data.summary}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Base>

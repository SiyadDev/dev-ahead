---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NextIssue from '../../components/NextIssue.astro';
import { SITE, url, repoUrl } from '../../config';
import { getIssues, sections, tagCounts, titleHtml, plainTitle } from '../../lib/issues';
import { formatDate } from '../../lib/watch';

export async function getStaticPaths() {
  const issues = await getIssues();
  return issues.map((issue, i) => ({
    params: { id: issue.id },
    props: { issue, newer: issues[i - 1], older: issues[i + 1] },
  }));
}

const { issue, newer, older } = Astro.props;
const latest = (await getIssues())[0];
const { Content, headings } = await render(issue);
const { data } = issue;
const contents = sections(headings, issue.body ?? '');
const tags = tagCounts(issue.body ?? '');
// The tags used in this issue, with what each one asks of the reader.
const tally = [
  { tag: 'ACT NOW', kind: 'act', means: 'Try it this week', count: tags['ACT NOW'] },
  { tag: 'WATCH', kind: 'watch', means: 'Likely to matter, not yet actionable', count: tags.WATCH },
  { tag: 'CONTEXT', kind: 'context', means: 'Worth knowing', count: tags.CONTEXT },
].filter((t) => t.count > 0);

const suggestUrl = repoUrl
  ? `${repoUrl}/issues/new?title=${encodeURIComponent(`Re: issue ${data.issue}: `)}`
  : '';
---

<Base title={plainTitle(data.title)} description={data.summary} type="article" published={data.date}>
  <article class="issue">
    <header class="issue-head">
      <div class="issue-strap">
        <p class="issue-date">
          <span class="no">Issue {data.issue}</span>
          <span><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>. </span>
          <span>Covers {data.window}.</span>
        </p>
        <p class="issue-about">
          <a href={url('/')}>Ahead of Main</a> is a twice-weekly brief on what's moving underneath developer news.
        </p>
      </div>
      <h1 set:html={titleHtml(data.title)} />
      <p class="summary">{data.summary}</p>
    </header>

    {(contents.length > 0 || tally.length > 0) && (
    <div class="issue-rail">
      <div class="issue-rail-inner">
        {
          contents.length > 0 && (
            <nav class="contents" id="contents" aria-labelledby="contents-title">
              <h2 id="contents-title">In this issue</h2>
              <ol class="quiet-links">
                {contents.map((s) => (
                  <li>
                    <a href={`#${s.slug}`}>{s.text}</a>
                    {s.items > 0 && (
                      <span class="count">
                        {s.items}
                        <span class="visually-hidden"> {s.unit}</span>
                      </span>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          tally.length > 0 && (
            <dl class="tag-key">
              {tally.map((t) => (
                <div>
                  <dt>
                    <span class={`tag tag-${t.kind}`}>{t.tag}</span> {t.count}
                  </dt>
                  <dd>{t.means}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>
    )}

    <div class="issue-main prose-body issue-body">
      <Content />
    </div>

    <footer class="issue-close">
      <div class="close-follow">
        <div>
          <h2>Get the next issue</h2>
          <p>
            A new one twice a week, in full by RSS or on{' '}
            {SITE.devto ? <a href={SITE.devto}>dev.to</a> : 'dev.to'}{SITE.linkedinNewsletter && ', or on LinkedIn'}.
          </p>
          <NextIssue latest={latest.data.date} />
        </div>
        <a class="button primary" href={url('/follow')}>Follow Ahead of Main</a>
      </div>
      {
        suggestUrl && (
          <p class="close-challenge">
            Spotted something I missed, or think a rating is wrong? <a href={suggestUrl}>Open an issue on GitHub</a>.
          </p>
        )
      }
      <nav class="pager" aria-label="More issues">
        {
          older && (
            <a class="prev" href={url(`/issues/${older.id}`)}>
              <span class="pager-dir">Previous: issue {older.data.issue}</span>
              <span class="pager-title" set:html={titleHtml(older.data.title)} />
            </a>
          )
        }
        {
          newer && (
            <a class="next" href={url(`/issues/${newer.id}`)}>
              <span class="pager-dir">Next: issue {newer.data.issue}</span>
              <span class="pager-title" set:html={titleHtml(newer.data.title)} />
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</Base>

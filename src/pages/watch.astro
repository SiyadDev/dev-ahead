---
import Base from '../layouts/Base.astro';
import { RUNGS, RUNG_MEANING, repoUrl } from '../config';
import { watch, rungIndex, isNew, formatDate, onRungSince, rungSlug, sourceLabel, type WatchEvent } from '../lib/watch';

// Highest rung first: the most advanced shifts lead.
const rungs = [...RUNGS].reverse().map((rung) => ({
  rung,
  n: rungIndex(rung),
  entries: watch.entries.filter((e) => e.status === rung),
}));

const shifts = (n: number) => `${n} ${n === 1 ? 'shift' : 'shifts'}`;
---

<Base
  title="Disruption Watch"
  description="A running board of the shifts changing how software gets built and paid for, with the evidence behind each rating."
>
  <header class="page-head">
    <h1>Disruption Watch</h1>
    <p class="standfirst">Ratings move on evidence, not on noise.</p>
    <p>
      {watch.entries.length} shifts changing how software gets built and paid for, each rated on a four-rung ladder and
      updated every issue. Last updated <time datetime={watch.updated}>{formatDate(watch.updated)}</time>.
    </p>
  </header>

  <nav aria-label="Rungs">
    <ol class="rung-index">
      {
        rungs.map(({ rung, n, entries }) => (
          <li class={`r${n}`}>
            <a href={`#${rungSlug(rung)}`}>
              <span class="pips" aria-hidden="true">
                {RUNGS.map((_, i) => (
                  <i class={i < n ? 'on' : ''} />
                ))}
              </span>
              <span class="rung-name">{rung}</span>
              <span class="count">{entries.length}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    rungs.map(({ rung, n, entries }) => (
      <section class={`rung r${n}`} id={rungSlug(rung)} aria-labelledby={`${rungSlug(rung)}-title`}>
        <header class="rung-head">
          <h2 id={`${rungSlug(rung)}-title`}>
            <span class="pips" aria-hidden="true">
              {RUNGS.map((_, i) => (
                <i class={i < n ? 'on' : ''} />
              ))}
            </span>
            {rung}
            <span class="count">{shifts(entries.length)}</span>
          </h2>
          <p>{RUNG_MEANING[rung]}</p>
        </header>
        {entries.length === 0 && <p class="rung-empty">Nothing on this rung right now.</p>}
        <ol class="board">
          {entries.map((e) => {
            const history: WatchEvent[] = [...e.history].reverse();
            const [latest, ...earlier] = history;
            const since = onRungSince(e);
            return (
              <li id={e.id}>
                <h3>
                  {e.name}
                  {isNew(e) && <span class="new">New</span>}
                </h3>
                {since && (
                  <p class="since">
                    On this rung since <time datetime={since}>{formatDate(since)}</time>
                  </p>
                )}
                <p class="note">{e.note}</p>
                <div class="evidence">
                  {latest ? (
                    <div class="evidence-latest">
                      <time datetime={latest.date}>{formatDate(latest.date)}</time>
                      <span>
                        {latest.note}{' '}
                        {latest.source ? (
                          <a class="src-link" href={latest.source}>
                            {sourceLabel(latest.source)}
                          </a>
                        ) : (
                          <span class="no-src">Source not logged</span>
                        )}
                      </span>
                    </div>
                  ) : (
                    <p class="evidence-none">No dated evidence logged yet.</p>
                  )}
                  {earlier.length > 0 && (
                    <details>
                      <summary>
                        <span class="when-closed">Show {earlier.length} earlier {earlier.length === 1 ? 'entry' : 'entries'}</span>
                        <span class="when-open">Hide earlier entries</span>
                      </summary>
                      <ol>
                        {earlier.map((h) => (
                          <li>
                            <time datetime={h.date}>{formatDate(h.date)}</time>
                            <span>
                              {h.note}{' '}
                              {h.source ? (
                                <a class="src-link" href={h.source}>
                                  {sourceLabel(h.source)}
                                </a>
                              ) : (
                                <span class="no-src">Source not logged</span>
                              )}
                            </span>
                          </li>
                        ))}
                      </ol>
                    </details>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }

  <p class="board-foot">
    An entry only moves when there's specific evidence, and each issue says what moved it. Entries can be held for lack
    of new evidence; the issue says when that's the case.
    {
      repoUrl && (
        <>
          {' '}
          Disagree with a rating? <a href={`${repoUrl}/issues/new`}>Open an issue</a>.
        </>
      )
    }
  </p>
</Base>
